# Copy to .env and fill in. Never commit the real .env.

# Optional — Anthropic API key. You can set it here, or skip this and paste
# it into the app's Settings page instead (stored server-side either way,
# never sent to the browser — build brief §3/§8). If both are set, the
# Settings-page key wins.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
PORT=8787
# PEDIGREE_EXTRACTION_MODEL=claude-opus-5
# PEDIGREE_PROSE_MODEL=claude-opus-5
# PEDIGREE_DB_PATH=./data/birds.db
