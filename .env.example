# Copy to .env and fill in. Never commit the real .env.

# Required — Anthropic API key. Held here, server-side, only. Never sent to
# the browser (build brief §3/§8).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
PORT=8787
# PEDIGREE_EXTRACTION_MODEL=claude-opus-5
# PEDIGREE_PROSE_MODEL=claude-opus-5
# PEDIGREE_DB_PATH=./data/birds.db
